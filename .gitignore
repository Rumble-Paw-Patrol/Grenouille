.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.DS_Store

# Données : jamais sous git (audio, embeddings, base). Les labels sont sauvegardés à part (§9, risque 10).
data/

# Configuration propre à une machine (chemin du disque externe) : voir config/local.example.yaml.
config/local.yaml

# Exports reçus (annotations, détections) : données de l'ONF, pas les nôtres. Ils restent en
# local, jamais sur GitHub.
documentation/*.xlsx

# Fichiers de verrou d'Office (document ouvert dans PowerPoint, Word, Excel).
~$*

# Tableau de bord : produit par documentation/tableau-de-bord/construire.py.
documentation/tableau-de-bord/index.html
documentation/tableau-de-bord/fichiers.json

# Journaux de copie et d'encodage de cette machine (scripts/ les écrit dans rapports/).
rapports/

# Copie des annotations de qui annote, réécrite par le poste après chaque envoi, à envoyer
# par mail (les CSV reçus se déposent, eux, dans annotations/ : voir LISEZMOI).
annotations/a_envoyer/
